WEBHOOK_URL="<your discord webhook url>"

# Month the recreation.gov availability API fetches (first of the month, ISO 8601 UTC)
MONTH_START="2026-06-01T00:00:00.000Z"

# Specific date inside MONTH_START to alert on (ISO 8601 UTC, no milliseconds)
TARGET_DATE="2026-06-27T00:00:00Z"

# How often to poll recreation.gov, in ms (90s default to stay under rate limits)
POLL_INTERVAL_MS=90000
