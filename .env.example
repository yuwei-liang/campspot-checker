WEBHOOK_URL="<your discord webhook url>"

# First month the recreation.gov availability API fetches (ISO 8601 UTC, first of month)
MONTH_START="2026-06-01T00:00:00.000Z"

# How many consecutive months to scan from MONTH_START (1..12).
MONTHS_TO_SCAN=1

# Multi-date polling: comma-separated weekday names (Sun/Mon/Tue/Wed/Thu/Fri/Sat).
# Expands to every matching night across all scanned months. Preferred over TARGET_DATE.
TARGET_WEEKDAYS="Thu,Fri,Sat"

# Single-date polling: only used when TARGET_WEEKDAYS is unset.
# TARGET_DATE="2026-06-27T00:00:00Z"

# How often to poll recreation.gov, in ms (90s default to stay under rate limits)
POLL_INTERVAL_MS=90000

# HTTP port the status server listens on (default 8787)
# PORT=8787

# Optional fast push channel. ntfy.sh pushes to your phone in ~1s (vs Discord's
# 5-15s on mobile) and the notification's tap action opens the rec.gov page with
# dates pre-filled. Pick a hard-to-guess topic name, then subscribe to it in the
# ntfy iOS/Android app. Discord stays on as a backup. Leave unset to disable.
# NTFY_TOPIC_URL="https://ntfy.sh/campspot-<your-random-token>"
